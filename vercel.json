{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "nestjs",
      "buildCommand": "npm run build -w @gbp/contracts && npm run build -w @gbp/api"
    },
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "buildCommand": "npm run build -w @gbp/contracts && npm run build -w @gbp/web",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "API_URL"
        }
      ]
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": { "service": "api" } },
    { "source": "/auth/:path*", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
