# No frontend environment variables are required for the bootstrap.
# Google credentials and tokens must never be placed in NEXT_PUBLIC_* variables.

# For npm run dev (separate ports), set this public BFF origin.
# Leave unset on Vercel and with vercel dev to use the shared domain.
# NEXT_PUBLIC_BFF_ORIGIN=http://localhost:3001

# API_URL is injected by Vercel's web -> api binding. Do not set it manually.

# Show local login only in next dev; API must independently enable it.
LOCAL_DEV_LOGIN_ENABLED=false

# LOCAL LAB ONLY: /labs/xss in development/test on a loopback host. Always off in production.
LOCAL_LAB=false

# Disable location editing in both apps; set the same value in API and web.
LOCATION_UPDATES_DISABLED=true
