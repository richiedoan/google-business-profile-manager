DATABASE_URL=postgresql://replace_me:replace_me@localhost:5432/replace_me

# Optional deterministic mock dataset size (1000-10000 total locations).
# MOCK_LOCATION_COUNT=1000

# Local-only login is disabled by default. Set true only for local development.
LOCAL_DEV_LOGIN_ENABLED=false
# Optional explicit web origin (HTTPS required in production).
# WEB_ORIGIN=http://localhost:3000

# Optional Google OIDC login. Configure all three values together, API only.
# GOOGLE_OAUTH_CLIENT_ID=replace_me
# GOOGLE_OAUTH_CLIENT_SECRET=replace_me
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/auth/google/callback

# LOCAL LAB ONLY. Never enable on a shared environment. Production rejects it.
LOCAL_LAB_ONLY=false
LOCAL_LAB_CORS_REFLECT=false
LOCAL_LAB_BROKEN_AUTHORIZATION=false

# Read-only GBP provider. Mock remains the default, including tests.
BUSINESS_PROFILE_PROVIDER=mock
# Shared Business OAuth client; separate callback from app login.
# GBP_GOOGLE_CLIENT_ID=replace_me
# GBP_GOOGLE_CLIENT_SECRET=replace_me
# GBP_GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google-business/callback
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep this key stable: changing it requires reconnecting Google accounts.
# GBP_TOKEN_ENCRYPTION_KEY=replace_with_64_hex_characters

# Disable location editing in both apps; set the same value in API and web.
LOCATION_UPDATES_DISABLED=false
