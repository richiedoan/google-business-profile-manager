{
  "name": "@gbp/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/main.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "NODE_ENV=production node dist/main.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@gbp/contracts": "0.0.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "dotenv": "^17.2.0",
    "google-auth-library": "^11.1.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "prisma": "6.19.3",
    "tsx": "^4.20.0"
  }
}
